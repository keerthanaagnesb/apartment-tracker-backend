# ==========================================
# Stage 1: Build the application using Maven
# ==========================================
FROM maven:3.9.6-eclipse-temurin-21-alpine AS build

# Set the working directory in the container
WORKDIR /app

# Copy pom.xml to cache dependencies
COPY pom.xml .

# Download dependencies (this layer will be cached unless pom.xml changes)
RUN mvn dependency:go-offline -B

# Copy the source code
COPY src ./src

# Build the application without running unit tests (faster build)
RUN mvn clean package -DskipTests

# ==========================================
# Stage 2: Create lightweight runtime image
# ==========================================
FROM eclipse-temurin:21-jre-alpine

# Set the working directory
WORKDIR /app

# Copy the built jar file from Stage 1
COPY --from=build /app/target/*.jar app.jar

# Render exposes the PORT environment variable dynamically (defaults to 8080)
ENV PORT=8080
EXPOSE 8080

# Run the application
ENTRYPOINT ["java", "-jar", "app.jar"]